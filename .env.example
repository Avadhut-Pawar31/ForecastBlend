# ==============================================================================
# ForecastBlend: Multi-Model Weather Intelligence Platform Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Frontend Dashboard API URL
# Leave empty for production same-origin deployment (/api/v1)
# Set to http://localhost:3001 during local separated development
VITE_API_BASE_URL=

# Data Ingestion & Storage Mode
# 'memory' (recommended for AWS Lambda / Vercel Serverless read-only environments)
# 'filesystem' (for local server storing precomputed JSON artifacts to disk)
DATA_STORE_MODE=memory

# External Provider Integrations (Optional)
# Open-Meteo is public and does not require a secret token for standard usage.
# If integrating authenticated European or IMD weather feeds, configure keys below:
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
# IMD_DATA_API_KEY=
